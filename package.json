{
  "name": "blumi",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "workspaces": [
    "apps/mobile",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "verify:source-hygiene": "node --test scripts/security/source-hygiene.test.mjs scripts/security/navigation-dependency.test.mjs scripts/security/legal-preflight.test.mjs apps/mobile/scripts/sentry-debug-plugin.test.mjs",
    "verify:operations-center": "node --test tools/operations-center/build.test.mjs",
    "verify:workbench-tools": "node --test tools/workbench/archive-from-manifest.test.mjs tools/workbench/remove-archived-from-manifest.test.mjs",
    "ops:center": "node tools/operations-center/build.mjs && node tools/operations-center/serve.mjs",
    "verify:postgres": "node scripts/security/postgres-gate.mjs",
    "verify:release-infra": "node --import tsx --test .railway/railway.test.ts",
    "start": "npm run dev:mobile",
    "gcp-build": "npm run build:server",
    "dev:mobile": "npm --workspace @blumi/mobile run start",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx apps/server/src/index.ts",
    "server:qa": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.qa.local --import tsx apps/server/src/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx apps/server/src/db/migrate.ts",
    "build:packages": "npm --workspace @blumi/contracts run build && npm --workspace @blumi/domain run build && npm --workspace @blumi/realtime-client run build",
    "build:server": "npm run build:packages && npm --workspace @blumi/server run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspace @blumi/mobile run lint",
    "doctor": "expo-doctor apps/mobile",
    "test": "npm run build:packages && npm --workspaces --if-present run test",
    "audit:release": "node scripts/security/run-audit.mjs",
    "verify": "npm run verify:source-hygiene && npm run verify:operations-center && npm run verify:workbench-tools && node --test scripts/security/audit-policy.test.mjs scripts/automation/local-backup.test.mjs scripts/automation/ci-db-backup.test.mjs && npm run verify:release-infra && npm run build:packages && npm run typecheck && npm run lint && npm run test && npm run verify:postgres && npm run audit:release && npm run doctor",
    "clean-clone:verify": "npm ci && npm run verify"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "expo-doctor": "^1.18.2",
    "patch-package": "8.0.1",
    "railway": "3.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-navigation/core": {
      "query-string": "9.5.1"
    },
    "@expo/metro-config": {
      "postcss": "8.5.26"
    },
    "xcode": {
      "uuid": "11.1.1"
    },
    "@grpc/grpc-js": "1.14.5"
  }
}

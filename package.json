{
  "name": "blumi",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "apps/mobile",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "verify:source-hygiene": "node --test scripts/security/source-hygiene.test.mjs scripts/security/navigation-dependency.test.mjs scripts/security/legal-preflight.test.mjs apps/mobile/scripts/sentry-debug-plugin.test.mjs",
    "verify:postgres": "node scripts/security/postgres-gate.mjs",
    "start": "npm run dev:mobile",
    "dev:mobile": "npm --workspace @blumi/mobile run start",
    "dev:server": "node --env-file-if-exists=.env.local --import tsx apps/server/src/index.ts",
    "server:qa": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.qa.local --import tsx apps/server/src/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx apps/server/src/db/migrate.ts",
    "build:packages": "npm --workspace @blumi/contracts run build && npm --workspace @blumi/domain run build && npm --workspace @blumi/realtime-client run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspace @blumi/mobile run lint",
    "doctor": "expo-doctor apps/mobile",
    "test": "npm --workspaces --if-present run test",
    "audit:release": "node scripts/security/run-audit.mjs",
    "verify": "npm run verify:source-hygiene && node --test scripts/security/audit-policy.test.mjs && npm run build:packages && npm run typecheck && npm run lint && npm run test && npm run verify:postgres && npm run audit:release && npm run doctor",
    "clean-clone:verify": "npm ci && npm run verify"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "expo-doctor": "^1.18.2",
    "patch-package": "8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-navigation/core": {
      "query-string": "9.5.1"
    },
    "@expo/metro-config": {
      "postcss": "8.5.26"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}

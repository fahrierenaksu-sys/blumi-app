# Local Blumi server defaults. Copy this file to .env.local and keep secrets out of Git.
NODE_ENV=development
# Set staging or production only with NODE_ENV=production.
BLUMI_DEPLOY_ENV=
HOST=127.0.0.1
PORT=4000
REALTIME_PORT=4100
BLUMI_AUTH_REPOSITORY=memory
# Firebase Phone Auth sends verification codes; the server only verifies Firebase ID tokens.
BLUMI_PUSH_PROVIDER=development
BLUMI_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
BLUMI_TRUST_PROXY=

# Firebase Phone Auth server verification. The service account value is only
# needed outside Google-managed runtimes; keep it in the deployment secret store.
FIREBASE_PROJECT_ID=blumi-mobile-eren
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional loopback-only QA authentication.
BLUMI_QA_AUTH_ENABLED=0
BLUMI_QA_PHONE_NUMBER=
BLUMI_QA_OTP_CODE=

# Production secrets must remain blank in the repository.
DATABASE_URL=
BLUMI_ADMIN_SIGNING_KEYS=
BLUMI_ADMIN_ACTIVE_KID=
BLUMI_OTP_HMAC_SECRET=
BLUMI_APPLE_APP_ID=
BLUMI_ANDROID_SHA256_CERT_FINGERPRINTS=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
EXPO_PUSH_ACCESS_TOKEN=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_COIN_PRODUCT_ID_MAP=
# Staging purchase tests use sandbox; production requires production.
REVENUECAT_PURCHASE_ENVIRONMENT=

# Blumi server environment template. Copy to an ignored local env file.
# Never commit real credentials or signing keys.

NODE_ENV=development
# Set staging or production only with NODE_ENV=production.
BLUMI_DEPLOY_ENV=
HOST=127.0.0.1
PORT=4000
# Local API and realtime use separate ports. Production may omit this to share PORT for one public origin.
REALTIME_PORT=4100

# Local development runs without PostgreSQL by default. Production must use postgres.
BLUMI_AUTH_REPOSITORY=memory
# DATABASE_URL=postgres://blumi:blumi@127.0.0.1:5432/blumi
# Optional pool settings (defaults shown; see apps/server/src/db/databasePoolConfig.ts
# and docs/quality/REALTIME_CAPACITY_2026-10-01.md before changing them in production).
# BLUMI_DB_POOL_MAX=10
# BLUMI_DB_POOL_IDLE_TIMEOUT_MS=30000
# BLUMI_DB_POOL_CONNECTION_TIMEOUT_MS=10000
# BLUMI_DB_STATEMENT_TIMEOUT_MS=
# BLUMI_DB_QUERY_TIMEOUT_MS=
# BLUMI_DB_APPLICATION_NAME=
# Session-capable URL for realtime LISTEN, needed only when DATABASE_URL uses a transaction pooler.
# BLUMI_DB_LISTEN_URL=
# Firebase Phone Auth sends verification codes; the server only verifies Firebase ID tokens.
BLUMI_PUSH_PROVIDER=development
BLUMI_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
BLUMI_TRUST_PROXY=

# Firebase Phone Auth server verification. Keep service-account material out of Git.
FIREBASE_PROJECT_ID=blumi-mobile-eren
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Production secrets. Keep blank in this template.
BLUMI_ADMIN_SIGNING_KEYS=
BLUMI_ADMIN_ACTIVE_KID=
BLUMI_ADMIN_LEGACY_KEY_ENABLED=0
BLUMI_ADMIN_KEY=
BLUMI_OTP_HMAC_SECRET=

# Optional, loopback-only QA authentication.
BLUMI_QA_AUTH_ENABLED=0
BLUMI_QA_PHONE_NUMBER=
BLUMI_QA_OTP_CODE=

BLUMI_APPLE_APP_ID=
BLUMI_ANDROID_SHA256_CERT_FINGERPRINTS=
BLUMI_CAPABILITY_MANIFEST=

# Set to 0 for text-only rooms, without LiveKit credentials. Default: 1.
BLUMI_VOICE_ENABLED=1
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
EXPO_PUSH_ACCESS_TOKEN=

# Set to 0 to reject real-money purchase verification and webhooks until connected.
# Does not disable inventory or spending previously owned coins.
BLUMI_PAYMENTS_ENABLED=1
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_COIN_PRODUCT_ID_MAP=
# Staging purchase tests use sandbox; production requires production.
REVENUECAT_PURCHASE_ENVIRONMENT=

{
  "name": "@blumi/server",
  "version": "1.0.0",
  "private": true,
  "description": "Blumi backend for auth, profile, chat, rooms, and realtime APIs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:mint-token": "tsx scripts/mint-admin-token.ts",
    "build": "tsc",
    "test:e2e:api": "npm run build && node --test dist/e2e/criticalAuthFlow.test.js",
    "test:e2e:api:postgres": "npm run build && node --test dist/e2e/criticalPostgresAuthFlow.test.js",
    "start": "node dist/index.js",
    "test": "node scripts/run-server-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blumi/contracts": "1.0.0",
    "@blumi/domain": "^1.0.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.1.0",
    "@types/ws": "^8.18.1",
    "fastify": "^5.10.0",
    "find-my-way": "9.7.0",
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}

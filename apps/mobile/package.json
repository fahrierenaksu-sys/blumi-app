    "test:wardrobe": "node --import tsx --test src/screens/WardrobeV2Screen.test.mjs src/screens/wardrobeV2Layout.test.ts",
    "test:avatar": "node scripts/run-avatar-starter-tests.mjs && node scripts/run-avatar-v2-tests.mjs",
    "test": "npm run test:release-config && npm run test:launch-config && npm run test:bundle-size && npm run test:theme && npm run test:accessibility && npm run test:layout && npm run test:privacy-recovery && npm run test:analytics && npm run test:session && npm run test:onboarding-navigation && npm run test:navigation && npm run test:connections && npm run test:chat && npm run test:realtime && npm run test:safety && npm run test:notifications && npm run test:discovery && npm run test:inventory && npm run test:match-room && npm run test:room-persistence && npm run test:room-hydration && npm run test:shop-preview-assets && npm run test:performance-assets && npm run test:wardrobe && npm run test:avatar",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },

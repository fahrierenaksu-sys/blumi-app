{
  "name": "@blumi/mobile",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "eas-build-post-install": "node --import tsx scripts/legal-preflight.ts",
    "test:privacy-recovery": "node --import tsx --test src/observability/crashPrivacy.test.ts src/ui/errorBoundaryCopy.test.ts src/ui/errorBoundary.test.ts",
    "start": "EXPO_PUBLIC_BLUMI_MEDIA_MODE=demo EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS=1 expo start --go --host lan --port 8081",
    "start:clear": "EXPO_PUBLIC_BLUMI_MEDIA_MODE=demo EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS=1 expo start --clear --go --host lan --port 8081",
    "start:dev-client": "EXPO_PUBLIC_BLUMI_MEDIA_MODE=demo expo start --dev-client --host lan --scheme blumi --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios --device \"iPhone 17 Pro Max\"",
    "web": "expo start --web",
    "test:release-config": "node --test scripts/mobile-release-config.test.mjs",
    "test:launch-config": "node --test scripts/mobile-launch-config.test.mjs",
    "test:bundle-size": "node --test scripts/mobile-bundle-size.test.mjs",
    "test:theme": "node --test scripts/mobile-theme-scope.test.mjs",
    "test:accessibility": "node --test scripts/mobile-accessibility-baseline.test.mjs",
    "test:layout": "node --test scripts/mobile-page-container-contract.test.mjs && npx tsx --test src/ui/layout/pageContainerLayout.test.ts src/ui/layout/appViewportMetrics.test.ts src/features/roomV2/myRoomLayoutMetrics.test.ts src/features/shop/shopLayoutMetrics.test.ts",
    "test:analytics": "node scripts/run-product-analytics-tests.mjs",
    "test:session": "node scripts/run-session-tests.mjs",
    "test:navigation": "node scripts/run-navigation-tests.mjs",
    "test:connections": "node scripts/run-connections-tests.mjs",
    "test:chat": "node scripts/run-chat-tests.mjs",
    "test:realtime": "node scripts/run-realtime-tests.mjs",
    "test:safety": "node scripts/run-safety-tests.mjs",
    "test:notifications": "node scripts/run-notification-tests.mjs",
    "test:discovery": "node scripts/run-discovery-tests.mjs",
    "test:inventory": "node scripts/run-inventory-tests.mjs",
    "test:match-room": "node scripts/run-match-room-tests.mjs",
    "test:room-persistence": "node scripts/run-room-persistence-tests.mjs",
    "test:avatar": "node scripts/run-avatar-starter-tests.mjs && node scripts/run-avatar-v2-tests.mjs",
    "test": "npm run test:release-config && npm run test:launch-config && npm run test:bundle-size && npm run test:theme && npm run test:accessibility && npm run test:layout && npm run test:privacy-recovery && npm run test:analytics && npm run test:session && npm run test:navigation && npm run test:connections && npm run test:chat && npm run test:realtime && npm run test:safety && npm run test:notifications && npm run test:discovery && npm run test:inventory && npm run test:match-room && npm run test:room-persistence && npm run test:avatar",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blumi/contracts": "1.0.0",
    "@blumi/domain": "1.0.0",
    "@blumi/realtime-client": "1.0.0",
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.3.16",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.102.8",
    "babel-preset-expo": "~57.0.0",
    "countries-list": "^3.4.1",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "libphonenumber-js": "^1.13.12",
    "livekit-client": "^2.22.1",
    "posthog-react-native": "^4.66.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "proxy-from-env": "^1.1.0",
    "typescript": "~6.0.3"
  },
  "private": true
}

    "test:navigation": "node scripts/run-navigation-tests.mjs",
    "test:connections": "node scripts/run-connections-tests.mjs",
    "test:chat": "node scripts/run-chat-tests.mjs",
    "test:realtime": "node scripts/run-realtime-tests.mjs",
    "test:safety": "node scripts/run-safety-tests.mjs",
    "test:notifications": "node scripts/run-notification-tests.mjs",
    "test:discovery": "node scripts/run-discovery-tests.mjs",
    "test:inventory": "node scripts/run-inventory-tests.mjs",
    "test:match-room": "node scripts/run-match-room-tests.mjs",
    "test:room-persistence": "node scripts/run-room-persistence-tests.mjs",
    "test:room-hydration": "node --import tsx --test src/features/roomV2/roomVisualLifecycle.integration.test.ts src/features/roomV2/roomSetupVisualContract.test.ts src/features/roomV2/roomV2EditorSessionIntegration.test.ts src/features/roomV2/roomV2ProviderLifecycle.test.ts src/screens/myRoomMotionLifecycle.test.ts src/screens/useRoomEditorInventoryEntries.test.mjs",
    "test:shop-preview-assets": "node --import tsx --test src/features/shop/shopAvatarPreviewAssets.test.ts src/features/shop/shopThumbnailLayout.test.ts src/features/shop/shopCatalogParity.test.ts src/features/shop/coralWaveShopCatalog.test.ts src/features/shop/shopCombinationSummary.test.ts src/features/shop/shopCombinationViewport.test.ts src/features/shop/shopCopy.test.ts src/features/shop/shopFormatters.test.ts src/features/shop/shopProductPresentation.test.ts && node --test src/features/shop/ShopNavigationControls.test.mjs src/features/shop/ShopPreviewPanel.combinationThumbnail.test.mjs src/screens/CosmeticShopScreen.test.mjs scripts/mobile-shop-presentation-contract.test.mjs",

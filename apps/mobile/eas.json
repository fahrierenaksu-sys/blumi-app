{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "native-ui-test": {
      "node": "22.22.2",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EAS_BUILD_PROFILE": "native-ui-test",
        "EXPO_PUBLIC_BLUMI_BUILD_PROFILE": "native-ui-test",
        "EXPO_PUBLIC_BLUMI_MEDIA_MODE": "demo",
        "EXPO_PUBLIC_BLUMI_ENABLE_DEMO": "1",
        "EXPO_PUBLIC_BLUMI_VOICE_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_PAID_COINS_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS": "0",
        "EXPO_PUBLIC_BLUMI_NATIVE_UI_TEST_SESSION_RESET": "1"
      }
    },
    "development": {
      "node": "22.22.2",
      "distribution": "internal",
      "env": {
        "EAS_BUILD_PROFILE": "development",
        "EXPO_PUBLIC_BLUMI_BUILD_PROFILE": "development",
        "EXPO_PUBLIC_BLUMI_MEDIA_MODE": "demo",
        "EXPO_PUBLIC_BLUMI_ENABLE_DEMO": "0",
        "EXPO_PUBLIC_BLUMI_VOICE_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS": "0"
      }
    },
    "server-test": {
      "node": "22.22.2",
      "distribution": "internal",
      "env": {
        "EAS_BUILD_PROFILE": "server-test",
        "EXPO_PUBLIC_BLUMI_BUILD_PROFILE": "server-test",
        "EXPO_PUBLIC_BLUMI_API_HTTP_URL": "https://blumi-app-production.up.railway.app",
        "EXPO_PUBLIC_REALTIME_EDGE_WS_URL": "wss://blumi-app-production.up.railway.app",
        "EXPO_PUBLIC_BLUMI_MEDIA_MODE": "demo",
        "EXPO_PUBLIC_BLUMI_ENABLE_DEMO": "0",
        "EXPO_PUBLIC_BLUMI_VOICE_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_PAID_COINS_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS": "0",
        "EXPO_PUBLIC_FIREBASE_DISABLE_APP_VERIFICATION": "0"
      }
    },
    "preview": {
      "node": "22.22.2",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "channel": "preview",
      "env": {
        "EAS_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_BLUMI_BUILD_PROFILE": "preview",
        "EXPO_PUBLIC_BLUMI_MEDIA_MODE": "native",
        "EXPO_PUBLIC_BLUMI_ENABLE_DEMO": "0",
        "EXPO_PUBLIC_BLUMI_VOICE_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_PAID_COINS_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS": "0"
      }
    },
    "production": {
      "node": "22.22.2",
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EAS_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_BLUMI_BUILD_PROFILE": "production",
        "EXPO_PUBLIC_BLUMI_MEDIA_MODE": "native",
        "EXPO_PUBLIC_BLUMI_ENABLE_DEMO": "0",
        "EXPO_PUBLIC_BLUMI_VOICE_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_PAID_COINS_ENABLED": "0",
        "EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6817587217"
      }
    },
    "preview": {
      "extends": "production"
    }
  }
}

# Public values compiled into the Blumi mobile bundle. Never place secrets here.
EXPO_PUBLIC_BLUMI_API_HTTP_URL=http://127.0.0.1:4000
EXPO_PUBLIC_REALTIME_EDGE_WS_URL=ws://127.0.0.1:4100
EXPO_PUBLIC_BLUMI_BUILD_PROFILE=development
EXPO_PUBLIC_BLUMI_MEDIA_MODE=demo
EXPO_PUBLIC_BLUMI_ENABLE_DEMO=1
EXPO_PUBLIC_BLUMI_QA_UNLOCK_AVATAR_ITEMS=0

# Optional public SDK identifiers. These are not server secrets.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Development-only route and visual QA gates. Keep disabled in release builds.
EXPO_PUBLIC_BLUMI_DEV_ENTRY_ROUTE=
EXPO_PUBLIC_BLUMI_NATIVE_UI_TEST_SESSION_RESET=0
EXPO_PUBLIC_BLUMI_ROOM_V3_DRAFT_PREVIEW=0

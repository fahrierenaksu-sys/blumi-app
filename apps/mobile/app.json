{
  "expo": {
    "name": "Blumi",
    "slug": "blumi",
    "version": "1.0.0",
    "scheme": "blumi",
    "orientation": "portrait",
    "icon": "./assets/brand/blumi-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "@config-plugins/react-native-webrtc",
      "./plugins/withAudioOnlyLiveRoom",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6F8"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-notifications",
      "@sentry/react-native",
      "./plugins/withSentryDebugSettings"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bitcode": false,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.blumi.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Blumi uses your microphone only when you choose to speak in a live room."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F26779"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.blumi.mobile",
      "versionCode": 1
    },
    "extra": {
      "buildProfile": "development",
      "enableDemo": true
    }
  }
}

{
  "expo": {
    "name": "Blumi",
    "slug": "blumi",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bc61197e-e1cb-478b-9f1d-61d8582d77c8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "blumi",
    "orientation": "portrait",
    "icon": "./assets/brand/blumi-app-icon-1024.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "./plugins/withIosDynamicFrameworks",
      "./plugins/withIosRecaptchaEnterprise",
      "./plugins/withNoMediaPermissions",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6F8"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-notifications",
      "@sentry/react-native",
      "./plugins/withSentryDebugSettings"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bitcode": false,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.blumi.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "supportsTablet": false,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F26779"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.blumi.mobile",
      "versionCode": 1
    },
    "extra": {
      "buildProfile": "development",
      "enableDemo": true,
      "eas": {
        "projectId": "bc61197e-e1cb-478b-9f1d-61d8582d77c8"
      }
    },
    "owner": "erenaksu"
  }
}
